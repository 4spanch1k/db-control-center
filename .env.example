# ================================
# Переменные окружения для DB Control Center
# ================================

# ================================
# Database Configuration
# ================================
DB_HOST=metadata-postgres
DB_PORT=5432
DB_NAME=control_center
DB_USER=postgres
DB_PASSWORD=postgres

# ================================
# Python Backend Configuration
# ================================
ENV=production
LOG_LEVEL=INFO
ENCRYPTION_KEY=
JWT_SECRET_KEY=
AUTO_APPLY_MIGRATIONS=true
MIGRATION_TIMEOUT_SEC=120

# ================================
# MinIO / S3 Configuration
# ================================
MINIO_ENDPOINT=minio:9000
MINIO_USER=minioadmin
MINIO_PASSWORD=minioadmin
MINIO_BUCKET=backups
MINIO_USE_SSL=false

# Backup retention (days)
BACKUP_RETENTION_DAYS=7

# ================================
# Telegram Alerts Configuration
# (Optional - leave empty to disable)
# ================================
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# ================================
# Next.js Application Configuration
# ================================
NODE_ENV=production
NEXT_PUBLIC_API_URL=http://localhost:3000
PYTHON_BACKEND_URL=http://python_backend:8000

# ================================
# Docker Network (for compose)
# ================================
COMPOSE_PROJECT_NAME=db-control-center
