# ================================
# Переменные окружения для DB Control Center
# ================================

# ================================
# Database Configuration
# ================================
DB_HOST=metadata-postgres
DB_PORT=5432
DB_NAME=control_center
DB_USER=postgres
DB_PASSWORD=postgres

# ================================
# Python Backend Configuration
# ================================
ENV=production
LOG_LEVEL=INFO
# Replace these defaults in production with strong random values.
ENCRYPTION_KEY=7c1S4OB99hOcaG_TjtnETIrRVifH8XSE0aX84wa8cwc=
JWT_SECRET_KEY=change-me-access-secret
JWT_REFRESH_SECRET_KEY=change-me-refresh-secret
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=7
AUTH_COOKIE_SECURE=false
AUTH_COOKIE_SAMESITE=lax
AUTH_COOKIE_DOMAIN=
AUTO_APPLY_MIGRATIONS=true
MIGRATION_TIMEOUT_SEC=120

# ================================
# MinIO / S3 Configuration
# ================================
MINIO_ENDPOINT=minio:9000
MINIO_USER=minioadmin
MINIO_PASSWORD=minioadmin
MINIO_BUCKET=backups
MINIO_USE_SSL=false

# Backup retention (days)
BACKUP_RETENTION_DAYS=7

# ================================
# Telegram Alerts Configuration
# (Optional - leave empty to disable)
# ================================
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# ================================
# Next.js Application Configuration
# ================================
NODE_ENV=production
NEXT_PUBLIC_API_URL=http://localhost:3000
PYTHON_BACKEND_URL=http://python_backend:8000

# ================================
# Billing / Stripe Configuration
# ================================
BILLING_PROVIDER=mock
APP_BASE_URL=http://localhost:3000
BILLING_CURRENCY=usd
BILLING_PRO_MONTHLY_CENTS=1900
BILLING_TEAM_MONTHLY_CENTS=7900
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_ID_OPERATOR_MONTHLY=
STRIPE_PRICE_ID_ADMIN_MONTHLY=

# ================================
# Docker Network (for compose)
# ================================
COMPOSE_PROJECT_NAME=db-control-center
